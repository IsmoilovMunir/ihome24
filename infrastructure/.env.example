# Опционально: только для Docker Compose из папки infrastructure/
# (порты, Postgres, MinIO). Скопируйте в infrastructure/.env
#
# Секреты Spring (DADATA_API_KEY, MAIL_*, TELEGRAM_*) — в backend/.env
# См. backend/.env.example

POSTGRES_DB=ihome24
POSTGRES_USER=iHome24db
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

MINIO_ROOT_USER=iHome24mino
MINIO_ROOT_PASSWORD=change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=ihome24-media

BACKEND_PORT=8080
ADMIN_PORT=5173
FRONTEND_PORT=3000
