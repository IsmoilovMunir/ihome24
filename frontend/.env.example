# Публичный сайт (Vite). Скопируйте в .env и подставьте значения.
# API бэкенда
# VITE_API_BASE_URL=https://ihome24.ru

# Яндекс.Карты JS API v3 (оформление заказа — карта доставки).
# Ключ: https://developer.tech.yandex.ru/
VITE_YANDEX_MAPS_API_KEY=

# Прод (один infrastructure/.env.prod): то же значение можно задать как
# VITE_YANDEX_MAPS_API_KEY=... или как YANDEX_MAPS_API_KEY=... — compose
# передаёт его в сборку фронта.
