# Канонический файл секретов backend (IntelliJ, mvn, Docker backend).
# Скопируйте: cp backend/.env.example backend/.env
# Не коммитьте backend/.env с паролями и токенами.
#
# Docker из infrastructure/ подхватывает этот же файл (env_file в docker-compose.yml).
# Порты Postgres/MinIO — опционально в infrastructure/.env (см. infrastructure/.env.example).

# SMTP (checkout, уведомления)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_EMAIL_FROM=

# Telegram (оптовые заявки)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING_ENABLED=false

# DaData — подсказки организаций в checkout
# Токен: https://dadata.ru/profile/#info
DADATA_API_KEY=
